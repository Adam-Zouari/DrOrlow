# Optional settings. A fresh copy automatically creates SQLite storage and an owner secret.
HOST=127.0.0.1
PORT=3000

# SQLite is the default. MySQL is used only when DB_CLIENT=mysql is explicit.
DB_CLIENT=sqlite
# SQLITE_PATH=data/drorlow.sqlite

# Optional MySQL: change DB_CLIENT to mysql, then configure these together.
# DB_CLIENT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=drorlow_app
# DB_PASSWORD=replace-with-your-local-database-password
# DB_NAME=DrOrlowDB

# MySQL private inbox: a separate reader with SELECT on form_submissions.
# DB_ADMIN_USER=drorlow_reader
# DB_ADMIN_PASSWORD=replace-with-your-reader-account-password
# Optional owner phrase override (20 to 256 characters).
# Otherwise startup saves a generated phrase in data/super-orlow.secret.
# SUPER_ORLOW_PASSWORD=replace-with-a-long-random-secret-phrase

# Enable certificate verification for a remote database that supports TLS.
# DB_SSL=true

# Production: your exact public origin, with no trailing slash.
# SITE_ORIGIN=https://your-domain.example
# Set only when the server is behind this many trusted reverse proxies.
# TRUST_PROXY_HOPS=1
